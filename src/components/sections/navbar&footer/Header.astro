---
import BrandLogo from "@/components/BrandLogo.astro";
import ThemeToggle from "@/components/ui/buttons/ThemeToggle.astro";
import Icon from "@/components/ui/icons/Icon.astro";
import MobileNavOverlay from "./MobileNavOverlay.astro";
import { NAV_LINKS, isActivePath } from "@consts/nav";

const { pathname } = Astro.url;
const pages = NAV_LINKS.map((page) => ({
	...page,
	active: isActivePath(pathname, page.href),
}));
---

<div class="sticky top-0 z-[100] flex justify-center px-4 pt-4">
	<div
		class="flex items-center gap-3 sm:gap-5 rounded-full border border-black/10 dark:border-white/10 bg-[var(--color-pill)] pl-3 pr-2 py-2 shadow-[0_10px_30px_-8px_rgba(0,0,0,0.5),0_0_40px_-10px_var(--color-primary-glow)] backdrop-blur-md"
	>
		<a href="/" class="flex shrink-0 items-center" aria-label="Ir al inicio">
			<BrandLogo class="text-primary h-7 w-7" />
		</a>

		<nav class="hidden lg:flex items-center gap-4">
			{pages.map(({ name, href, active }) => (
				<a href={href}
					class:list={[
						"font-display font-bold uppercase tracking-wide text-sm transition-colors hover:text-primary before:content-['•'] before:mr-4 before:font-normal before:text-textLight/40 first:before:content-none",
						active ? "text-primary" : "text-textDark dark:text-neutral-300",
					]}
				>
					{name}
				</a>
			))}
		</nav>

		<a href="/lbdtwtv"
			class="hidden lg:inline-flex items-center gap-1 rounded-full bg-primary px-4 py-1.5 font-display text-sm font-extrabold uppercase tracking-wide text-primary-ink hover:brightness-110 transition"
		>
			★ En vivo
		</a>

		<ThemeToggle />

		<button
			id="menu-button"
			class="relative z-[110] size-9 flex items-center justify-center lg:hidden bg-primary/10 rounded-full font-bold active:scale-95 transition-all"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Abrir menú"
		>
			<span id="icon-open" class="text-xl">
				<Icon icon="menu" size="22" />
			</span>
			<span id="icon-close" class="hidden text-xl">
				<Icon icon="close" size="22" />
			</span>
		</button>
	</div>
</div>

<MobileNavOverlay />