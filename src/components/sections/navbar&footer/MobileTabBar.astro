---
import { NAV_LINKS, isActivePath } from "@consts/nav";
import Icon from "@/components/ui/icons/Icon.astro";

const { pathname } = Astro.url;

const ICONS = ["home", "noticias", "twitch"] as const;

const tabs = NAV_LINKS.map((page, i) => ({
	...page,
	active: isActivePath(pathname, page.href),
	icon: ICONS[i],
}));
---

<div class="lg:hidden fixed inset-x-0 bottom-0 z-100 flex justify-center px-4 pb-[calc(0.9rem+env(safe-area-inset-bottom))]">
	<nav
		aria-label="Navegación principal"
		class="flex w-full max-w-sm items-center gap-1 rounded-full border border-black/10 dark:border-white/10 bg-pill p-2 shadow-[0_10px_30px_-8px_rgba(0,0,0,0.5)] backdrop-blur-xl"
	>
		{tabs.map(({ href, active, icon }) => (
			<a href={href}
				class:list={[
					"flex flex-1 flex-col items-center gap-0.5 rounded-full py-2 transition-colors",
					active
						? "text-primary bg-primary/10"
						: "text-textLight dark:text-neutral-400 hover:text-primary",
				]}
			>
				<Icon icon={icon} size="22" />
			</a>
		))}
	</nav>
</div>