---
import { NAV_LINKS } from "@consts/nav";
---

<div
	id="mobile-menu"
	role="dialog"
	aria-modal="true"
	aria-label="Menú de navegación"
	class="fixed inset-0 h-dvh w-full z-[100] hidden flex-col items-center justify-center bg-white/90 dark:bg-[var(--bg-web)]/95 backdrop-blur-md opacity-0 transition-all duration-300 lg:hidden"
	style="-webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);"
>
	<ul id="menu-list" class="flex flex-col items-center gap-8 relative z-[120]">
		{NAV_LINKS.map(({ name, href }) => (
			<li class="overflow-hidden">
				<a href={href}
					class="nav-link block font-display italic text-textDark dark:text-white text-4xl font-black translate-y-full opacity-0 transition-all duration-500 ease-out uppercase hover:text-primary"
				>
					{name}
				</a>
			</li>
		))}
		<li class="overflow-hidden">
			<a href="/lbdtwtv"
				class="nav-link inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2 font-display text-xl font-extrabold uppercase text-primary-ink translate-y-full opacity-0 transition-all duration-500 ease-out"
			>
				★ En vivo
			</a>
		</li>
	</ul>
</div>

<style>
	:global(body.overflow-hidden) {
		overflow: hidden;
	}
	.nav-link {
		transition: transform 0.5s ease-out, opacity 0.5s ease-out, color 0.3s ease;
	}
</style>

<script is:inline>
	function setupMenu() {
		const btn = document.getElementById('menu-button');
		const menu = document.getElementById('mobile-menu');
		const menuList = document.getElementById('menu-list');
		const iconOpen = document.getElementById('icon-open');
		const iconClose = document.getElementById('icon-close');
		const links = document.querySelectorAll('.nav-link');

		if (!btn || !menu) return;

		const closeMenu = () => {
			btn.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('overflow-hidden');
			menu.style.opacity = '0';
			iconOpen.classList.remove('hidden');
			iconClose.classList.add('hidden');
			links.forEach(link => {
				link.style.transform = 'translateY(100%)';
				link.style.opacity = '0';
			});
			setTimeout(() => {
				menu.classList.add('hidden');
				menu.style.display = 'none';
			}, 300);
		};

		const openMenu = () => {
			btn.setAttribute('aria-expanded', 'true');
			document.body.classList.add('overflow-hidden');
			menu.classList.remove('hidden');
			menu.style.display = 'flex';
			iconOpen.classList.add('hidden');
			iconClose.classList.remove('hidden');

			setTimeout(() => {
				menu.style.opacity = '1';
				links.forEach((link, i) => {
					setTimeout(() => {
						link.style.transform = 'translateY(0)';
						link.style.opacity = '1';
					}, i * 100);
				});
				links[0]?.focus();
			}, 10);
		};

		btn.onclick = (e) => {
			e.stopPropagation();
			const isExpanded = btn.getAttribute('aria-expanded') === 'true';
			isExpanded ? closeMenu() : openMenu();
		};

		menu.onclick = (e) => {
			if (menuList && !menuList.contains(e.target)) {
				closeMenu();
			}
		};

		links.forEach(link => {
			link.onclick = () => {
				if (window.innerWidth < 1024) closeMenu();
			};
		});

		document.onkeydown = (e) => {
			if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
				closeMenu();
				btn.focus();
			}
		};
	}

	setupMenu();
	document.addEventListener('astro:page-load', setupMenu);
</script>