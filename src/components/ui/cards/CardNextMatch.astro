---
import { fetchMatchStatus } from '@/lib/nextmatch.js'
import MatchMiniCard from './MatchMiniCard.astro'

let status = null
try {
  status = await fetchMatchStatus(import.meta.env.RAPIDAPI_KEY)
} catch (e) {
  console.error('[CardNextMatch] Error al obtener el estado del partido:', e)
}

const recentOrLive = status?.recentOrLive ?? null
const upcoming = status?.upcoming ?? null

const isLive = Boolean(recentOrLive?.isLive)

const recentCard = recentOrLive && {
  key: 'recent',
  title: isLive ? '🔴 En vivo' : 'Partido anterior',
  variant: isLive ? 'live' : 'neutral',
  match: recentOrLive
}

const upcomingCard = upcoming && {
  key: 'upcoming',
  title: 'Próximo partido',
  variant: 'accent',
  match: upcoming
}

// La card más importante va primero: en vivo > próximo partido > último jugado
const important = isLive ? recentCard : (upcomingCard ?? recentCard)
const other = important === recentCard ? upcomingCard : recentCard

const cards = [important, other].filter(
  (card): card is NonNullable<typeof card> => card !== null
)

const title: string = `Próximo <span class="text-primary">Partido</span>`
---

{
  match && (
    <section class="mx-auto max-w-340 px-4 sm:px-6 lg:px-8" id="next-match-card">
      <div class="rounded-2xl bg-surface-2 p-5 sm:p-6 shadow-sm">
        <span
          id="nm-badge"
          class:list={[
            "inline-block rounded-full px-3 py-1 text-xs font-bold",
            match.isLive ? "bg-red-500 text-white animate-pulse" : "bg-accent text-accent-ink"
          ]}
        >
          {match.isLive ? `🔴 EN VIVO · ${match.statusDescription}` : '⚽ Próximo partido'}
        </span>

    <div
      class="match-carousel flex gap-4 overflow-x-auto custom-scrollbar snap-x snap-mandatory -mr-4 pr-4 sm:mr-0 sm:pr-0 sm:grid sm:grid-cols-2 sm:overflow-visible"
    >
      {cards.map((card) => (
        <div class="w-[85%] shrink-0 snap-center sm:w-auto sm:shrink">
          <MatchMiniCard
            title={card.title}
            variant={card.variant}
            match={card.match}
            badgeId={card.key === 'recent' ? 'nm-recent-badge' : undefined}
            scoreLocalId={card.key === 'recent' ? 'nm-recent-local-score' : undefined}
            scoreVisitantId={card.key === 'recent' ? 'nm-recent-visitant-score' : undefined}
            statusId={card.key === 'recent' ? 'nm-recent-status' : undefined}
          />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .custom-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .custom-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const POLL_INTERVAL_MS = 60_000

  async function refreshMatchStatus () {
    try {
      const res = await fetch('/api/nextmatch.json')
      if (!res.ok) return
      const status = await res.json()
      const recent = status?.recentOrLive
      if (!recent || !recent.isLive) return // solo actualizamos en caliente mientras está en vivo

      const badge = document.getElementById('nm-recent-badge')
      const scoreLocal = document.getElementById('nm-recent-local-score')
      const scoreVisitant = document.getElementById('nm-recent-visitant-score')
      const statusEl = document.getElementById('nm-recent-status')
      if (!badge || !scoreLocal || !scoreVisitant) return

      scoreLocal.textContent = String(recent.localTeam.score)
      scoreVisitant.textContent = String(recent.visitantTeam.score)
      if (statusEl) statusEl.textContent = `· ${recent.statusDescription}`
    } catch (e) {
      console.error('[CardNextMatch] Error actualizando el partido:', e)
    }
  }

  if (document.getElementById('next-match-card')) {
    setInterval(refreshMatchStatus, POLL_INTERVAL_MS)
  }
</script>