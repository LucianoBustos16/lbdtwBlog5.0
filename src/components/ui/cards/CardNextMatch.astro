---
import { fetchMatchStatus } from '@/lib/nextmatch.js'
import { buildCards, renderMatchCards } from '@/lib/matchCards.js'

// Datos al momento de compilar: se muestran de entrada y el navegador
// los reemplaza enseguida con los actuales (ver script de abajo).
let status = null
try {
  status = await fetchMatchStatus(import.meta.env.RAPIDAPI_KEY)
} catch (e) {
  console.error('[CardNextMatch] Error al obtener el estado del partido:', e)
}

const cards = buildCards(status)
---

<section
  class="mx-auto max-w-340 px-4 sm:px-6 lg:px-8"
  id="next-match-card"
  hidden={cards.length === 0}
>

    <div
      data-match-cards
      class="match-carousel flex gap-4 overflow-x-auto custom-scrollbar snap-x snap-mandatory -mr-4 pr-4 sm:mr-0 sm:pr-0 sm:grid sm:grid-cols-2 sm:overflow-visible"
      set:html={renderMatchCards(cards)}
    />
  
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .custom-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { buildCards, renderMatchCards } from '@/lib/matchCards.js'

  const FAST_MS = 60_000 // en vivo o cerca del partido
  const SLOW_MS = 5 * 60_000 // el resto del tiempo

  let timer: ReturnType<typeof setTimeout> | undefined
  let lastJson = ''

  // Refresca seguido si hay partido en vivo o si el próximo empieza
  // en menos de 2 h (o empezó hace menos de 3 h y la API todavía no lo marcó en vivo).
  function nextDelay (status: any) {
    if (status?.recentOrLive?.isLive) return FAST_MS
    const start = status?.upcoming?.startTimestamp
    if (start) {
      const diff = start - Date.now() / 1000
      if (diff < 2 * 3600 && diff > -3 * 3600) return FAST_MS
    }
    return SLOW_MS
  }

  async function refresh () {
    const section = document.getElementById('next-match-card')
    const container = section?.querySelector<HTMLElement>('[data-match-cards]')
    if (!section || !container) return
    clearTimeout(timer)

    let status = null
    try {
      const res = await fetch('/api/nextmatch.json')
      if (res.ok) status = await res.json()
    } catch (e) {
      console.error('[CardNextMatch] Error actualizando el partido:', e)
    }

    if (status && !status.error) {
      const json = JSON.stringify(status)
      if (json !== lastJson) {
        lastJson = json
        const cards = buildCards(status)
        if (cards.length > 0) {
          container.innerHTML = renderMatchCards(cards)
          section.hidden = false
        }
      }
    }

    if (!document.hidden) timer = setTimeout(refresh, nextDelay(status))
  }

  // No consulta mientras la pestaña está en segundo plano; al volver, refresca al toque.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearTimeout(timer)
    else refresh()
  })

  refresh()
</script>
