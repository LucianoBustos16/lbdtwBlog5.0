---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "@utils/utils";

interface Props {
  title: string;
  url: string;
  image: ImageMetadata;
  author: string;
  date: Date | string;
}

const { title, url, image, author, date } = Astro.props;
---

<a
  class="group relative block rounded-xl outline-none ring-zinc-500 transition duration-500 focus-visible:ring dark:ring-neutral-900 dark:focus:outline-none"
  href={`/blog/${url}`}
  data-astro-prefetch
>
  <div
    class="relative h-87.5 w-full shrink-0 overflow-hidden rounded-xl bg-surface-2 before:absolute before:inset-x-0 before:z-1 before:size-full before:bg-linear-to-t before:from-neutral-900/70"
  >
    <!-- Decorativa: el título del link ya describe la nota -->
    <Image
      src={image}
      alt=""
      width={680}
      height={350}
      layout="constrained"
      fit="cover"
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="lazy"
      class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-110"
      draggable="false"
    />
  </div>

  <div class="absolute inset-x-0 top-0 z-10">
    <div class="flex h-full flex-col p-4 sm:p-6">
      <div class="ms-2.5 sm:ms-4 text-sm">
        <p class="font-bold text-neutral-50">{author}</p>
        <time class="text-xs text-neutral-50/80" datetime={new Date(date).toISOString()}>
          {formatDate(date)}
        </time>
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-10">
    <div class="flex h-full flex-col p-4 sm:p-6">
      <h3
        class="text-balance text-2xl font-bold text-neutral-50 group-hover:text-neutral-50/80 md:text-3xl"
      >
        {title}
      </h3>
    </div>
  </div>
</a>
