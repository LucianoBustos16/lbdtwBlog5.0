---
import { formatDate } from "@utils/utils";
import Icon from "@/components/ui/icons/Icon.astro";

interface Props {
  image?: string;
  title: string;
  alt?: string;
  url?: string;
  author?: string;
  date?: string;
  isViewAll?: boolean;
}

const { url, image, title, alt, author, date, isViewAll } = Astro.props;
---

{
  isViewAll ? (
    <a
      href={url || "/blog"}
      class="group rounded-2xl h-142.5 w-80 snap-center relative shrink-0 cursor-pointer flex flex-col items-center justify-center gap-4 border-2 border-dashed border-border bg-surface-2 transition-all duration-300 hover:border-primary hover:bg-primary/10"
      role="button"
      tabindex="0"
    >
      <span class="flex size-16 items-center justify-center rounded-full bg-primary text-primary-ink shadow-lg shadow-primary/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
        <Icon icon="arrowRight" size="28" />
      </span>

      <div class="text-center">
        <h3 class="text-xl font-bold text-textDark dark:text-neutral-100">
          {title}
        </h3>
        <p class="text-sm text-textLight">Descubrí todas las noticias</p>
      </div>
    </a>
  ) : (
    <a
      href={`/blog/${url || ""}`}
      class="group rounded-2xl h-142.5 w-80 snap-center bg-primary relative shrink-0 cursor-pointer bg-center bg-size-[100%] hover:bg-size-[105%] transition-[background-size]"
      role="button"
      tabindex="0"
    >
      <div class="relative h-full w-full shrink-0 overflow-hidden rounded-xl before:absolute before:inset-x-0 before:z-1 before:size-full before:bg-linear-to-t before:from-neutral-900/70">
        {image && (
          <img
            class="absolute inset-s-0 top-0 size-full object-cover transition duration-500 group-hover:scale-110"
            src={`/images/blog/${image}`}
            alt={alt}
            draggable={"false"}
            loading={"eager"}
          />
        )}
      </div>

      <div class="absolute inset-x-0 bottom-0 z-10">
        <div class="flex h-full flex-col gap-4 p-4 sm:p-6">
          <h3 class="text-balance text-xl font-bold text-neutral-50 group-hover:text-neutral-50/80 md:text-2xl">
            {title}
          </h3>

          {author && (
            <div class="itext-sm">
              <h4 class="font-bold text-neutral-50">{author}</h4>
              <p class="text-xs text-neutral-50/80">{formatDate(date)}</p>
            </div>
          )}
        </div>
      </div>
    </a>
  )
}
