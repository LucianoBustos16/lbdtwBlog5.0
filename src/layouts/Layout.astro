---
import FooterSection from '@/components/sections/navbar&footer/FooterSection.astro';
import Header from '@/components/sections/navbar&footer/Header.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
				<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<title>LBDTw - {title}</title>

		<script is:inline>
			const setDarkMode = () => {
				if (localStorage.darkMode === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark')
					localStorage.darkMode = 'true';
				} else {
					document.documentElement.classList.remove('dark')
					localStorage.darkMode = 'false';
				}
			}
	
			setDarkMode();
			// Runs on view transitions navigation
			document.addEventListener('astro:after-swap', setDarkMode);
		</script>
	<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3FN59ZC3N5"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		
		  gtag('config', 'G-3FN59ZC3N5');
		</script>

		<script>
			let previousTitle = document.title;
			let blurTitle = '¡Volvé virgo...!';
			let intervalId: number | undefined;

			function cambiarTitulo() {
			document.title = document.title === blurTitle ? previousTitle : blurTitle;
			}

			window.addEventListener('blur', () => {
			intervalId = setInterval(cambiarTitulo, 900);
			});

			window.addEventListener('focus', () => {
			clearInterval(intervalId);
			document.title = previousTitle;
			});

		</script>

	</head>
	<body class="selection:bg-primary selection:text-neutral-200 bg-[var(--bg-web)]">
		<Header />
		<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
			<slot />
		</div>
		<FooterSection />
	</body>
</html>
<style >
	:root {
	--color-primary: #C9F31D;
	--color-primary-ink: #0A0F02;
	--color-accent: #0598D1;
	--color-accent-ink: #ffffff;

	--color-surface: #ffffff;
	--color-surface-2: #f2f3f5;
	--color-border: #dce0e6;

	--color-textDark: #12141b;
	--color-textLight: #5b6472;

	--color-pill: #ffffffcc;
	--color-primary-glow: transparent;

	--bg-color: #ffffff80;
	--background-color: #ffffffc5;
	--bg-web: #f4f5f7;
	}
 
  .dark {
	--color-surface: #12141b;
	--color-surface-2: #1a1d26;
	--color-border: #262a36;

	--color-textDark: #f2f5f9;
	--color-textLight: #9aa5b4;

	--color-pill: #12141bcc;
	--color-primary-glow: rgba(201,243,29,0.35);

    --bg-color: #00000028;
	--background-color: #00021479;
	--bg-web: #05070d;
  }
</style>
